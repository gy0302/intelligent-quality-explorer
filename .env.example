"""
环境变量模板
作用：定义所有需要的环境变量，不含敏感信息
团队成员根据此文件创建自己的.env文件
"""
# 应用配置
APP_NAME=Smart Test Pilot Pro
APP_VERSION=0.1.0
DEBUG=True

# LLM配置
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen:7b

# 测试配置
DEFAULT_TEST_FRAMEWORK=pytest
MAX_TEST_CASES_PER_ENDPOINT=20

# 路径配置
OUTPUTS_DIR=./outputs
GENERATED_TESTS_DIR=./outputs/generated_tests