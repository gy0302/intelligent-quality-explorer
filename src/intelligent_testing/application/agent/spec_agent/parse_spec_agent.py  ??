import yaml
import json
from typing import Dict, Any
from ...application.agent.base_agent import BaseAgent
from ...application.ports.spec_parser import SpecParser
from ...models.specification import OpenAPISpecification, APIOperation, APIParameter, APIResponse, HTTPMethod
from loguru import logger


class ParseSpecAgent(BaseAgent):
    """规范解析智能体"""

    def __init__(self, spec_parser: SpecParser):
        self.spec_parser = spec_parser

    def parse_from_file(self, file_path: str) -> OpenAPISpecification:
        """从文件解析"""
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()
        return self.parse(content)

    def parse(self, spec_content: str) -> OpenAPISpecification:
        """解析规范内容"""
        logger.info("开始解析OpenAPI规范...")

        # 首先验证规范
        if not self.spec_parser.validate(spec_content):
            raise ValueError("无效的OpenAPI规范")

        # 使用解析器解析
        spec = self.spec_parser.parse(spec_content)

        logger.success(f"解析完成: {spec.title} v{spec.version}, 共{len(spec.operations)}个操作")
        return spec